# MAIN SCAN\
# \uc0\u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
\
def run_scan():\
    # \uc0\u9472 \u9472  Validate keys \u9472 \u9472 \
    if ALPACA_API_KEY in ("your_key_id_here", "") or \\\
       ALPACA_API_SECRET in ("your_secret_key_here", ""):\
        print("\\n  \uc0\u10060  ERROR: Alpaca API keys not set.")\
        print("     Paste your Key ID and Secret Key into the top of this file:")\
        print("         ALPACA_API_KEY    = \\"your_key_id_here\\"")\
        print("         ALPACA_API_SECRET = \\"your_secret_key_here\\"")\
        print("     Get them from: https://alpaca.markets \uc0\u8594  Dashboard \u8594  API Keys\\n")\
        sys.exit(1)\
\
    client = _build_client()\
    now_et = datetime.now(ET)\
\
    print("=" * 65)\
    print(f"  FIRST CANDLE RULE \'97 FVG SIGNAL SCANNER (Live)")\
    print(f"  Data Source:  Alpaca")\
    print(f"  Scan Time:    \{now_et.strftime('%Y-%m-%d %H:%M:%S %Z')\}")\
    print(f"  Watchlist:    \{len(WATCHLIST)\} symbols")\
    print("=" * 65)\
\
    strategies  = [STRAT_A, STRAT_B]\
    all_signals = []\
\
    for ticker in WATCHLIST:\
        print(f"\\n  Scanning \{ticker\}...")\
        for strat in strategies:\
            log.info(f"  \{ticker\} \uc0\u8594  \{strat['label']\}")\
            signal = scan_ticker(client, ticker, strat)\
            if signal:\
                all_signals.append(signal)\
                print(f"    \uc0\u10003  Signal detected: \{strat['label']\}")\
\
    # \uc0\u9472 \u9472  Results \u9472 \u9472 \
    print("\\n" + "=" * 65)\
    if not all_signals:\
        print("  No signals detected across watchlist.")\
        print("  This is normal if:")\
        print("    \'95 Market hasn't opened yet today")\
        print("    \'95 It's a weekend or holiday")\
        print("    \'95 No FVGs formed with confirmed retests")\
    else:\
        print(f"  \{len(all_signals)\} SIGNAL(S) DETECTED\\n")\
        for i, s in enumerate(all_signals, 1):\
            print(f"  \uc0\u9472 \u9472  Signal #\{i\} \u9472 \u9472 ")\
            print(f"    Ticker:        \{s['ticker']\}")\
            print(f"    Strategy:      \{s['strategy']\}")\
            print(f"    Direction:     \{s['direction']\}")\
            print(f"    Entry:         $\{s['entry_price']\}")\
            print(f"    Stop Loss:     $\{s['stop_price']\}")\
            print(f"    Take Profit:   $\{s['target_price']\}")\
            print(f"    Risk:          $\{s['risk']\}")\
            print(f"    R/R:           \{s['risk_reward']\}")\
            print(f"    First Candle:  High $\{s['first_high']\} / Low $\{s['first_low']\}")\
            print(f"    FVG Type:      \{s['fvg']['type'].capitalize()\}")\
            print(f"    FVG Time:      \{s['fvg']['time'].strftime('%H:%M %Z')\}")\
            print(f"    Entry Time:    \{s['entry_time'].strftime('%H:%M %Z')\}")\
            print()\
\
    print("=" * 65)\
\
    # \uc0\u9472 \u9472  Save to JSON \u9472 \u9472 \
    serialisable = []\
    for s in all_signals:\
        out = \{k: v for k, v in s.items() if k != "fvg"\}\
        out["fvg_type"]    = s["fvg"]["type"]\
        out["fvg_time"]    = s["fvg"]["time"].strftime("%Y-%m-%d %H:%M:%S %Z")\
        out["entry_time"]  = s["entry_time"].strftime("%Y-%m-%d %H:%M:%S %Z")\
        out["retest_time"] = s["retest_time"].strftime("%Y-%m-%d %H:%M:%S %Z")\
        serialisable.append(out)\
\
    with open("signals_output.json", "w") as f:\
        json.dump(serialisable, f, indent=2)\
    print(f"\\n  Signals saved to signals_output.json")\
\
\
