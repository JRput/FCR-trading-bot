\
def _min_to_timeframe(minutes: int) -> TimeFrame:\
    """\
    Maps an integer minute value to the closest Alpaca TimeFrame.\
    Alpaca supports: 1min, 5min, 15min, 30min, 1hr natively.\
    """\
    mapping = \{\
        1:  TimeFrame.Minute,\
        5:  TimeFrame(5, TimeFrameUnit.Minute),\
        15: TimeFrame(15, TimeFrameUnit.Minute),\
        30: TimeFrame(30, TimeFrameUnit.Minute),\
    \}\
    if minutes not in mapping:\
        raise ValueError(f"Unsupported timeframe: \{minutes\} minutes. Use 1, 5, 15, or 30.")\
    return mapping[minutes]\
\
\
# \uc0\u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
# DATA FETCHER\
# \uc0\u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
\
def fetch_bars(client: StockHistoricalDataClient,\
               ticker: str, interval_min: int) -> pd.DataFrame:\
    """\
    Fetches today's intraday bars for a single ticker from Alpaca.\
\
    Returns a DataFrame with Open, High, Low, Close, Volume columns\
    and a DatetimeIndex converted to US/Eastern.\
    """\
    now_et   = datetime.now(ET)\
    # Start from 09:25 ET to capture the 9:30 open candle cleanly\
    start_et = now_et.replace(hour=9, minute=25, second=0, microsecond=0)\
    # Convert to UTC for the API call\
    start_utc = start_et.astimezone(pytz.utc)\
    end_utc   = now_et.astimezone(pytz.utc)\
\
    timeframe = _min_to_timeframe(interval_min)\
\
    request_params = StockBarsRequest(\
        symbol_or_symbols=ticker,\
        timeframe=timeframe,\
        start=start_utc,\
        end=end_utc,\
        limit=1000\
    )\
\
    try:\
        bars = client.get_stock_bars(request_params)\
    except Exception as e:\
        log.warning(f"  \{ticker\}: Alpaca error \'97 \{e\}")\
        return pd.DataFrame()\
\
    # alpaca-py returns a dict keyed by symbol; grab this ticker's data\
    if ticker not in bars.data:\
        log.info(f"  \{ticker\}: No bars returned for \{interval_min\}-min")\
        return pd.DataFrame()\
\
    bar_list = bars.data[ticker]\
    if not bar_list:\
        log.info(f"  \{ticker\}: Empty bar list for \{interval_min\}-min")\
        return pd.DataFrame()\
\
    # Build DataFrame from the list of Bar objects\
    records = []\
    for bar in bar_list:\
        records.append(\{\
            "timestamp": bar.timestamp,\
            "Open":      float(bar.open),\
            "High":      float(bar.high),\
            "Low":       float(bar.low),\
            "Close":     float(bar.close),\
            "Volume":    int(bar.volume)\
        \})\
\
    df = pd.DataFrame(records)\
    df = df.set_index("timestamp")\
\
    # Ensure index is in Eastern Time\
    if df.index.tz is None:\
        df.index = df.index.tz_localize("UTC")\
    df.index = df.index.tz_convert(ET)\
\
    return df\
\
\
# \uc0\u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
# FIRST CANDLE EXTRACTION\
# \uc0\u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
\
def get_first_candle(df: pd.DataFrame):\
    """\
    Extracts the first candle after the 9:30 AM ET open.\
    Bars are labelled by open time, so we grab the first bar at or after 9:30.\
\
    Returns: (candle_row, high, low) or (None, None, None)\
    """\
    now_et   = datetime.now(ET)\
    open_ts  = pd.Timestamp(\
        now_et.replace(hour=9, minute=30, second=0, microsecond=0), tz=ET\
    )\
\
    candidates = df.loc[df.index >= open_ts]\
    if candidates.empty:\
        return None, None, None\
\
    first_candle = candidates.iloc[[0]]\
    high = float(first_candle["High"].iloc[0])\
    low  = float(first_candle["Low"].iloc[0])\
    return first_candle, high, low\
\
\
# \uc0\u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
# FAIR VALUE GAP (FVG) DETECTION\
# \uc0\u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
\
def detect_fvgs(df: pd.DataFrame) -> list[dict]:\
    """\
    Scans for Fair Value Gaps \'97 three-candle patterns where price moves\
    so fast it leaves a gap between candle 1 and candle 3.\
\
    Bullish FVG:  candle[i+2].low  > candle[i].high   \uc0\u8594  upward gap\
    Bearish FVG:  candle[i+2].high < candle[i].low    \uc0\u8594  downward gap\
    """\
    fvgs   = []\
    highs  = df["High"].values\
    lows   = df["Low"].values\
    times  = df.index\
\
    for i in range(len(df) - 2):\
        if lows[i + 2] > highs[i]:\
            fvgs.append(\{\
                "type":       "bullish",\
                "time":       times[i + 1],\
                "gap_top":    float(lows[i + 2]),\
                "gap_bottom": float(highs[i]),\
                "candle_idx": i\
            \})\
        if highs[i + 2] < lows[i]:\
            fvgs.append(\{\
                "type":       "bearish",\
                "time":       times[i + 1],\
                "gap_top":    float(lows[i]),\
                "gap_bottom": float(highs[i + 2]),\
                "candle_idx": i\
            \})\
    return fvgs\
\
\
# \uc0\u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
# RETEST + ENGULFING CONFIRMATION\
# \uc0\u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
\
def check_retest_and_engulf(df: pd.DataFrame, fvg: dict) -> dict | None:\
    """\
    After an FVG forms, looks for:\
      1. A candle that retests (pulls back into) the FVG zone\
      2. The next candle engulfs that retest candle in the FVG direction\
\
    Returns signal details on confirmation, otherwise None.\
    """\
    idx        = fvg["candle_idx"]\
    gap_top    = fvg["gap_top"]\
    gap_bottom = fvg["gap_bottom"]\
    fvg_type   = fvg["type"]\
\
    start = idx + 3\
    if start >= len(df) - 1:\
        return None\
\
    closes = df["Close"].values\
    highs  = df["High"].values\
    lows   = df["Low"].values\
    times  = df.index\
\
    for j in range(start, len(df) - 1):\
        retest = j\
        engulf = j + 1\
\
        if fvg_type == "bullish":\
            retest_hit = gap_bottom <= lows[retest] <= gap_top\
            engulf_hit = closes[engulf] > highs[retest]\
            if retest_hit and engulf_hit:\
                entry = closes[engulf]\
                stop  = lows[retest]\
                return \{\
                    "direction":   "LONG",\
                    "entry_price": round(entry, 4),\
                    "stop_price":  round(stop, 4),\
                    "risk":        round(entry - stop, 4),\
                    "retest_time": times[retest],\
                    "entry_time":  times[engulf],\
                    "fvg":         fvg\
                \}\
\
        elif fvg_type == "bearish":\
            retest_hit = gap_bottom <= highs[retest] <= gap_top\
            engulf_hit = closes[engulf] < lows[retest]\
            if retest_hit and engulf_hit:\
                entry = closes[engulf]\
                stop  = highs[retest]\
                return \{\
                    "direction":   "SHORT",\
                    "entry_price": round(entry, 4),\
                    "stop_price":  round(stop, 4),\
                    "risk":        round(stop - entry, 4),\
                    "retest_time": times[retest],\
                    "entry_time":  times[engulf],\
                    "fvg":         fvg\
                \}\
\
    return None\
\
\
# \uc0\u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
# FIRST CANDLE BREAKOUT FILTER\
# \uc0\u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
\
def filter_by_first_candle_break(confirm_df: pd.DataFrame,\
                                  first_high: float, first_low: float,\
                                  signal: dict) -> bool:\
    """\
    Confirms that price broke out of the first candle's range before\
    the FVG formed. Bullish FVG needs a break above; bearish needs below.\
    """\
    fvg_time = signal["fvg"]["time"]\
    fvg_type = signal["fvg"]["type"]\
\
    pre_fvg = confirm_df.loc[confirm_df.index < fvg_time]\
    if pre_fvg.empty:\
        return False\
\
    if fvg_type == "bullish" and pre_fvg["High"].max() > first_high:\
        return True\
    if fvg_type == "bearish" and pre_fvg["Low"].min() < first_low:\
        return True\
\
    return False\
\
\
# \uc0\u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
# FULL STRATEGY PIPELINE\
# \uc0\u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
\
def scan_ticker(client: StockHistoricalDataClient,\
                ticker: str, strategy: dict) -> dict | None:\
    """\
    Runs the full detection pipeline for one ticker under one strategy:\
      1. Fetch anchor bars \uc0\u8594  extract first candle high/low\
      2. Fetch confirmation bars \uc0\u8594  detect FVGs\
      3. Check retest + engulf on each FVG\
      4. Filter by first-candle breakout\
      5. Apply R/R to set take-profit target\
    """\
    anchor_min  = strategy["anchor_min"]\
    confirm_min = strategy["confirm_min"]\
    rr          = strategy["rr"]\
\
    # Step 1\
    anchor_df = fetch_bars(client, ticker, anchor_min)\
    if anchor_df.empty:\
        return None\
\
    first_candle, first_high, first_low = get_first_candle(anchor_df)\
    if first_candle is None:\
        log.info(f"  \{ticker\}: No first candle found on \{anchor_min\}-min chart")\
        return None\
\
    log.info(f"  \{ticker\}: First \{anchor_min\}-min candle \'97 High: \{first_high\}, Low: \{first_low\}")\
\
    # Step 2\
    confirm_df = fetch_bars(client, ticker, confirm_min)\
    if confirm_df.empty:\
        return None\
\
    # Step 3\
    fvgs = detect_fvgs(confirm_df)\
    if not fvgs:\
        log.info(f"  \{ticker\}: No FVGs on \{confirm_min\}-min chart")\
        return None\
\
    log.info(f"  \{ticker\}: \{len(fvgs)\} FVG(s) found on \{confirm_min\}-min chart")\
\
    # Steps 4 & 5\
    for fvg in fvgs:\
        signal = check_retest_and_engulf(confirm_df, fvg)\
        if signal is None:\
            continue\
\
        if not filter_by_first_candle_break(confirm_df, first_high, first_low, signal):\
            continue\
\
        # Set take-profit\
        risk = signal["risk"]\
        if signal["direction"] == "LONG":\
            signal["target_price"] = round(signal["entry_price"] + (risk * rr), 4)\
        else:\
            signal["target_price"] = round(signal["entry_price"] - (risk * rr), 4)\
\
        signal["ticker"]      = ticker\
        signal["strategy"]    = strategy["label"]\
        signal["risk_reward"] = f"\{rr\}:1"\
        signal["first_high"]  = round(first_high, 4)\
        signal["first_low"]   = round(first_low, 4)\
\
        return signal\
\
    return None\
